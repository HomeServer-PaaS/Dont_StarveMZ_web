# Copy this file to .env and replace every password/secret before starting.
MYSQL_ROOT_PASSWORD=replace-with-a-local-root-password
MYSQL_DATABASE=guljima_mz_portal
MYSQL_USER=portal_app
MYSQL_PASSWORD=replace-with-a-local-app-password
MYSQL_PORT=3306
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
DEMO_AUTH_ENABLED=true
APP_COOKIE_SECURE=false
APP_PORT=8080
